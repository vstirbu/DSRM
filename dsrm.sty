\ProvidesPackage{dsrm}[2026/11/13 v0.2.0 DSRM diagrams]

\newif\ifdsrmshowemptyinputs
\dsrmshowemptyinputsfalse
\DeclareOption{showemptyinputs}{\dsrmshowemptyinputstrue}
\ProcessOptions\relax

\RequirePackage{xparse}
\RequirePackage{ifthen}
\RequirePackage{tikz}

\usetikzlibrary{positioning}
\usetikzlibrary{arrows.meta}
\usetikzlibrary{backgrounds}

\newlength{\phaseboxheight}
\setlength{\phaseboxheight}{3cm}
\newsavebox{\dsrmmeasurebox}
\newlength{\dsrmrequiredheight}

% Measure with the same font, wrapping width and node padding as the diagram.
\newcommand{\dsrmmeasurephase}[2]{%
    \setlength{\mywidth}{4cm}%
    \addtolength{\mywidth}{-#1}%
    \sbox{\dsrmmeasurebox}{%
        \begin{tikzpicture}[font=\large]
            \node[text width=\mywidth, text centered] {#2};
        \end{tikzpicture}%
    }%
    % The body starts 2cm below the top; leave padding underneath it.
    \setlength{\dsrmrequiredheight}{%
        \dimexpr\ht\dsrmmeasurebox+\dp\dsrmmeasurebox+2cm+.5em+1pt\relax}%
    \ifdim\dsrmrequiredheight>\phaseboxheight
        \setlength{\phaseboxheight}{\dsrmrequiredheight}%
    \fi
    % Phase separators in the measuring pass must not become output spaces.
    \ignorespaces
}

%https://tex.stackexchange.com/a/408183/255362
\newlength{\mywidth}

\newcommand{\phaseinput}[1]{
\ifthenelse{\equal{#1}{1}}{Problem-centered approach}{}%
\ifthenelse{\equal{#1}{2}}{Objective centered approach}{}%
\ifthenelse{\equal{#1}{3}}{Design and development centred approach}{}%
\ifthenelse{\equal{#1}{4}}{Observing a solution}{}%
}

\newcommand{\phasetitle}[1]{
\ifthenelse{\equal{#1}{1}}{Problem identification and motivation}{}%
\ifthenelse{\equal{#1}{2}}{Objectives of the solution}{}%
\ifthenelse{\equal{#1}{3}}{Design and development}{}%
\ifthenelse{\equal{#1}{4}}{Demonstration}{}%
}

\newcommand{\sdrmphaseinputt}[4][]{
    \setlength{\mywidth}{4cm}
    % \addtolength{\mywidth}{-#1cm}
    \addtolength{\mywidth}{-.5em}
    \draw[thick, fill=white] (0,0) rectangle (4,\phaseboxheight);
    \draw[] (2,\phaseboxheight-1cm) rectangle (2,\phaseboxheight-1cm)
    node[midway, text width=\mywidth, text centered] {\textbf{\phasetitle{#2}}};
    \draw (2,\phaseboxheight-2cm) rectangle (2,\phaseboxheight-2cm)
    node[below,text width=\mywidth, text centered] {#3};

    \ifthenelse{\equal{#1}{}}{%
        \ifdsrmshowemptyinputs
            \draw[thick, gray] (0,-3.5) rectangle (4,-1);
            \node[text width=\mywidth, text centered, gray]
                at (2,-2) {\textbf{\phaseinput{#2}}};
            \draw[ultra thick,-{Stealth}, gray, dashed] (2,-1) -- (2,0);
        \fi
    }{%
        \node[text width=\mywidth, text centered]
            at (2,-2) {\textbf{\phaseinput{#2}}};

        \node[anchor=north, text width=\mywidth, text centered]
            (inputtext) at (2,-3) {#1};

        % Add padding below the actual text.
        \coordinate (inputbottom)
            at ([yshift=-.5em]inputtext.south);

        % Draw behind the text.
        \begin{scope}[on background layer]
            \draw[thick, fill=gray, fill opacity=.1]
                (0,-1) rectangle (4,0 |- inputbottom);
        \end{scope}

        \draw[ultra thick,-{Stealth}] (2,-1) -- (2,0);
    }
}

\newcommand{\sdrmphase}[2]{
    \setlength{\mywidth}{4cm}
    \addtolength{\mywidth}{-1.5em}
    \draw[thick, fill=white] (0,0) rectangle (4,\phaseboxheight);
    \draw[] (2,\phaseboxheight-1cm) rectangle (2,\phaseboxheight-1cm)
    node[midway, text width=\mywidth, text centered] {%
        \textbf{%
            \ifthenelse{\equal{#1}{5}}{Evaluation}{}%
            \ifthenelse{\equal{#1}{6}}{Communication}{}
        }
        };
    \draw (2,\phaseboxheight-2cm) rectangle (2,\phaseboxheight-2cm)
    node[below,text width=\mywidth, text centered] {#2};
}


\newcommand{\DSR}[1]{%
    \begingroup%
    \setlength{\phaseboxheight}{3cm}%
    \newcommand{\ProblemIdentification}[2][]{\dsrmmeasurephase{.5em}{##2}}%
    \newcommand{\ObjectivesOfTheSolution}[2][]{\dsrmmeasurephase{.5em}{##2}}%
    \newcommand{\DesignAndDevelopment}[2][]{\dsrmmeasurephase{.5em}{##2}}%
    \newcommand{\Demonstration}[2][]{\dsrmmeasurephase{.5em}{##2}}%
    \newcommand{\Evaluation}[1]{\dsrmmeasurephase{1.5em}{##1}}%
    \newcommand{\Communication}[1]{\dsrmmeasurephase{1.5em}{##1}}%
    \ignorespaces#1%
    \renewcommand{\ProblemIdentification}[2][]{%
        \begin{scope}[%
            shift = {(0, 0)}%
            ]%
            \sdrmphaseinputt[##1]{1}{##2};%
        \end{scope}%
    }%
    \renewcommand{\ObjectivesOfTheSolution}[2][]{%
        \begin{scope}[%
            shift = {(4.5, 0)}%
            ]%
            \sdrmphaseinputt[##1]{2}{##2};%
        \end{scope}%
    }%
    \renewcommand{\DesignAndDevelopment}[2][]{%
        \begin{scope}[%
            shift = {(9, 0)}%
            ]%
            \sdrmphaseinputt[##1]{3}{##2};%
        \end{scope}%
    }%
    \renewcommand{\Demonstration}[2][]{%
        \begin{scope}[%
            shift = {(13.5, 0)}%
            ]%
            \sdrmphaseinputt[##1]{4}{##2};%
        \end{scope}%
    }%
    \renewcommand{\Evaluation}[1]{%
        \begin{scope}[%
            shift = {(18, 0)}%
            ]%
            \sdrmphase{5}{##1};%
        \end{scope}%
    }%
    \renewcommand{\Communication}[1]{%
        \begin{scope}[%
            shift = {(22.5, 0)}%
            ]%
            \sdrmphase{6}{##1};%
        \end{scope}%
    }%
%
    \begin{tikzpicture}[font=\large]%\sffamily]%, every node/.style={scale=1.2}]
        \begin{scope}%
            % horizontal line through phase boxes
            \draw[ultra thick,-{Stealth}] (4,\phaseboxheight-1cm) -- (22.5,\phaseboxheight-1cm);%
            \draw[ultra thick] (6.5,\phaseboxheight+1cm) -- (24.5,\phaseboxheight+1cm);%
            \draw[ultra thick,-{Stealth}] (6.5,\phaseboxheight+1cm) -- (6.5,\phaseboxheight);%
            \draw[ultra thick,-{Stealth}] (11,\phaseboxheight+1cm) -- (11,\phaseboxheight);%
            \draw[ultra thick] (20,\phaseboxheight) -- (20,\phaseboxheight+1cm);%
            \draw[ultra thick] (24.5,\phaseboxheight) -- (24.5,\phaseboxheight+1cm);%
        \end{scope}%
        #1%
    \end{tikzpicture}%
    \endgroup%
}%

% Iterated diagrams keep phase columns fixed and measure each row separately.
\newif\ifdsrmiterationmeasuring
\newcount\dsrmiterationrow
\newcount\dsrmiterationpreviousrow
\newcount\dsrmiterationcommunicationrow
\newcount\dsrmiterationindex
\newcount\dsrmiterationendindex
\newlength{\dsrmiterationtop}
\newlength{\dsrmiterationbottom}
\newlength{\dsrmiterationpreviousbottom}
\newlength{\dsrmiterationx}
\newlength{\dsrmiterationoccupied}

\newcommand{\dsrmiterationclearance}[1]{%
    \ifcsname dsrmiterationcolumn#1\endcsname
        \setlength{\dsrmiterationoccupied}{%
            \csname dsrmiterationcolumn#1\endcsname}%
        \addtolength{\dsrmiterationoccupied}{-1cm}%
        \ifdim\dsrmiterationoccupied<\dsrmiterationtop
            \setlength{\dsrmiterationtop}{\dsrmiterationoccupied}%
        \fi
    \fi
}

\newcommand{\dsrmiterationphase}[3][]{%
    \ifdsrmiterationmeasuring
        \ifnum#2>\dsrmiterationlastindex\relax
            \edef\dsrmiterationlastindex{#2}%
        \else
            \PackageError{dsrm}{Iteration phases must be in increasing order}%
                {Use each phase once per iteration, in methodology order.}%
        \fi
        \ifnum#2<6
            \ifx\dsrmiterationfirstindex\empty
                \edef\dsrmiterationfirstindex{#2}%
            \fi
        \fi
        \edef\dsrmiterationcolumns{\dsrmiterationcolumns
            \noexpand\dsrmiterationclearance{#2}}%
        \ifnum#2<5
            \dsrmmeasurephase{.5em}{#3}%
        \else
            \dsrmmeasurephase{1.5em}{#3}%
        \fi
    \else
        \edef\dsrmiterationnode{dsrm-iteration-\the\dsrmiterationrow-phase-#2}%
        \pgfmathsetlength{\dsrmiterationx}{(#2-1)*4.5cm}%
        \begin{scope}[shift={(\dsrmiterationx,\dsrmiterationbottom)}]
            \ifnum#2<5
                \sdrmphaseinputt[#1]{#2}{#3}{}%
            \else
                \sdrmphase{#2}{#3}%
            \fi
            \coordinate (\dsrmiterationnode-north) at (2,\phaseboxheight);
            \coordinate (\dsrmiterationnode-south) at (2,0);
            \coordinate (\dsrmiterationnode-west) at (0,\phaseboxheight-1cm);
            \coordinate (\dsrmiterationnode-east) at (4,\phaseboxheight-1cm);
            \coordinate (\dsrmiterationnode-occupied) at (2,0);
            \ifnum#2<5
                \ifthenelse{\equal{#1}{}}{%
                    \ifdsrmshowemptyinputs
                        \coordinate (\dsrmiterationnode-occupied) at (2,-3.5);
                    \fi
                }{%
                    \coordinate (\dsrmiterationnode-occupied) at (inputbottom);
                }%
            \fi
        \end{scope}%
        \pgfextracty{\dsrmiterationoccupied}{%
            \pgfpointanchor{\dsrmiterationnode-occupied}{center}}%
        \expandafter\edef\csname dsrmiterationcolumn#2\endcsname{%
            \the\dsrmiterationoccupied}%
        \ifnum#2=6
            \ifx\dsrmiterationcommunication\empty
                \edef\dsrmiterationcommunication{\dsrmiterationnode}%
                \dsrmiterationcommunicationrow=\dsrmiterationrow
            \else
                \PackageError{dsrm}{Only one Communication phase is allowed}%
                    {Place Communication in one iteration; the final phase connects to it.}%
            \fi
        \else
            \ifx\dsrmiterationlastnode\empty
                \edef\dsrmiterationfirstnode{\dsrmiterationnode}%
            \else
                \draw[thick,-{Stealth}]
                    (\dsrmiterationlastnode-east) -- (\dsrmiterationnode-west);
            \fi
            \edef\dsrmiterationlastnode{\dsrmiterationnode}%
            \edef\dsrmiterationlastphase{#2}%
        \fi
    \fi
    \ignorespaces
}

\newcommand{\dsrmiterationmeasure}[1]{%
    \advance\dsrmiterationrow by 1
    \setlength{\phaseboxheight}{3cm}%
    \def\dsrmiterationlastindex{0}%
    \let\dsrmiterationfirstindex\empty
    \let\dsrmiterationcolumns\empty
    \ignorespaces#1%
    \expandafter\edef\csname dsrmiterationheight\the\dsrmiterationrow\endcsname{%
        \the\phaseboxheight}%
    \expandafter\let\csname dsrmiterationcolumns\the\dsrmiterationrow\endcsname
        \dsrmiterationcolumns
    \expandafter\let\csname dsrmiterationfirst\the\dsrmiterationrow\endcsname
        \dsrmiterationfirstindex
    \ignorespaces
}

\newcommand{\dsrmiteration}[1]{%
    \advance\dsrmiterationrow by 1
    \setlength{\phaseboxheight}{%
        \csname dsrmiterationheight\the\dsrmiterationrow\endcsname}%
    \ifnum\dsrmiterationrow=1
        \setlength{\dsrmiterationtop}{0pt}%
    \else
        \setlength{\dsrmiterationtop}{\dsrmiterationpreviousbottom}%
        \addtolength{\dsrmiterationtop}{-1cm}%
    \fi
    \csname dsrmiterationcolumns\the\dsrmiterationrow\endcsname
    \expandafter\let\expandafter\dsrmiterationfirstindex
        \csname dsrmiterationfirst\the\dsrmiterationrow\endcsname
    \ifx\dsrmiterationfirstindex\empty
        \PackageError{dsrm}{An iteration needs at least one phase before Communication}%
            {Add a phase from ProblemIdentification through Evaluation.}%
    \else
        % Leave the feedback arrow clear of inputs in all columns it crosses.
        \ifnum\dsrmiterationrow>1
            \dsrmiterationindex=\dsrmiterationfirstindex\relax
            \dsrmiterationendindex=\dsrmiterationpreviousphase\relax
            \ifnum\dsrmiterationindex>\dsrmiterationendindex
                \dsrmiterationendindex=\dsrmiterationindex
                \dsrmiterationindex=\dsrmiterationpreviousphase\relax
            \fi
            \loop
                \dsrmiterationclearance{\the\dsrmiterationindex}%
                \ifnum\dsrmiterationindex<\dsrmiterationendindex
                    \advance\dsrmiterationindex by 1
            \repeat
        \fi
        \setlength{\dsrmiterationbottom}{%
            \dimexpr\dsrmiterationtop-\phaseboxheight\relax}%
        \let\dsrmiterationfirstnode\empty
        \let\dsrmiterationlastnode\empty
        \ignorespaces#1%
        \ifx\dsrmiterationpreviousnode\empty\else
            \coordinate (dsrm-iteration-turn) at (0,\dsrmiterationtop+.5cm);
            \draw[thick,-{Stealth}] (\dsrmiterationpreviousnode-south)
                -- (\dsrmiterationpreviousnode-south |- dsrm-iteration-turn)
                -| (\dsrmiterationfirstnode-north);
        \fi
        \edef\dsrmiterationpreviousnode{\dsrmiterationlastnode}%
        \edef\dsrmiterationpreviousphase{\dsrmiterationlastphase}%
        \dsrmiterationpreviousrow=\dsrmiterationrow
        \setlength{\dsrmiterationpreviousbottom}{\dsrmiterationbottom}%
    \fi
    \ignorespaces
}

\newcommand{\DSRIterations}[1]{%
    \begingroup
    \dsrmiterationrow=0
    \let\dsrmiterationpreviousnode\empty
    \let\dsrmiterationcommunication\empty
    \newcommand{\Iteration}[1]{%
        \ifdsrmiterationmeasuring
            \dsrmiterationmeasure{##1}%
        \else
            \dsrmiteration{##1}%
        \fi
        \ignorespaces}%
    \newcommand{\ProblemIdentification}[2][]{\dsrmiterationphase[##1]{1}{##2}}%
    \newcommand{\ObjectivesOfTheSolution}[2][]{\dsrmiterationphase[##1]{2}{##2}}%
    \newcommand{\DesignAndDevelopment}[2][]{\dsrmiterationphase[##1]{3}{##2}}%
    \newcommand{\Demonstration}[2][]{\dsrmiterationphase[##1]{4}{##2}}%
    \newcommand{\Evaluation}[1]{\dsrmiterationphase{5}{##1}}%
    \newcommand{\Communication}[1]{\dsrmiterationphase{6}{##1}}%
    \dsrmiterationmeasuringtrue
    \ignorespaces#1%
    \dsrmiterationmeasuringfalse
    \dsrmiterationrow=0
    \begin{tikzpicture}[font=\large]
        #1%
        \ifx\dsrmiterationcommunication\empty\else
            \ifnum\dsrmiterationcommunicationrow=\dsrmiterationpreviousrow
                \draw[thick,-{Stealth}] (\dsrmiterationpreviousnode-east)
                    -- (\dsrmiterationcommunication-west);
            \else
                \draw[thick,-{Stealth}] (\dsrmiterationpreviousnode-east)
                    -- (\dsrmiterationcommunication-south |- \dsrmiterationpreviousnode-east)
                    -- (\dsrmiterationcommunication-south);
            \fi
        \fi
    \end{tikzpicture}%
    \endgroup
}
