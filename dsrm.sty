\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{dsrm}[2026/11/13 v0.1.0 DSRM diagrams]

\newif\ifdsrmshowemptyinputs
\dsrmshowemptyinputsfalse
\DeclareOption{showemptyinputs}{\dsrmshowemptyinputstrue}
\ProcessOptions\relax

\RequirePackage{xparse}
\RequirePackage{ifthen}
\RequirePackage{tikz}

\usetikzlibrary{positioning}
\usetikzlibrary{arrows.meta}
\usetikzlibrary{backgrounds}

\newlength{\phaseboxheight}
\setlength{\phaseboxheight}{3cm}
\newsavebox{\dsrmmeasurebox}
\newlength{\dsrmrequiredheight}

% Measure with the same font, wrapping width and node padding as the diagram.
\newcommand{\dsrmmeasurephase}[2]{%
    \setlength{\mywidth}{4cm}%
    \addtolength{\mywidth}{-#1}%
    \sbox{\dsrmmeasurebox}{%
        \begin{tikzpicture}[font=\large]
            \node[text width=\mywidth, text centered] {#2};
        \end{tikzpicture}%
    }%
    % The body starts 2cm below the top; leave padding underneath it.
    \setlength{\dsrmrequiredheight}{%
        \dimexpr\ht\dsrmmeasurebox+\dp\dsrmmeasurebox+2cm+.5em+1pt\relax}%
    \ifdim\dsrmrequiredheight>\phaseboxheight
        \setlength{\phaseboxheight}{\dsrmrequiredheight}%
    \fi
    % Phase separators in the measuring pass must not become output spaces.
    \ignorespaces
}

%https://tex.stackexchange.com/a/408183/255362
\newlength{\mywidth}

\newcommand{\phaseinput}[1]{
\ifthenelse{\equal{#1}{1}}{Problem-centered approach}{}%
\ifthenelse{\equal{#1}{2}}{Objective centered approach}{}%
\ifthenelse{\equal{#1}{3}}{Design and development centred approach}{}%
\ifthenelse{\equal{#1}{4}}{Observing a solution}{}%
}

\newcommand{\phasetitle}[1]{
\ifthenelse{\equal{#1}{1}}{Problem identification and motivation}{}%
\ifthenelse{\equal{#1}{2}}{Objectives of the solution}{}%
\ifthenelse{\equal{#1}{3}}{Design and development}{}%
\ifthenelse{\equal{#1}{4}}{Demonstration}{}%
}

\newcommand{\sdrmphaseinputt}[4][]{
    \setlength{\mywidth}{4cm}
    % \addtolength{\mywidth}{-#1cm}
    \addtolength{\mywidth}{-.5em}
    \draw[thick, fill=white] (0,0) rectangle (4,\phaseboxheight);
    \draw[] (2,\phaseboxheight-1cm) rectangle (2,\phaseboxheight-1cm)
    node[midway, text width=\mywidth, text centered] {\textbf{\phasetitle{#2}}};
    \draw (2,\phaseboxheight-2cm) rectangle (2,\phaseboxheight-2cm)
    node[below,text width=\mywidth, text centered] {#3};

    \ifthenelse{\equal{#1}{}}{%
        \ifdsrmshowemptyinputs
            \draw[thick, gray] (0,-3.5) rectangle (4,-1);
            \node[text width=\mywidth, text centered, gray]
                at (2,-2) {\textbf{\phaseinput{#2}}};
            \draw[ultra thick,-{Stealth}, gray, dashed] (2,-1) -- (2,0);
        \fi
    }{%
        \node[text width=\mywidth, text centered]
            at (2,-2) {\textbf{\phaseinput{#2}}};

        \node[anchor=north, text width=\mywidth, text centered]
            (inputtext) at (2,-3) {#1};

        % Add padding below the actual text.
        \coordinate (inputbottom)
            at ([yshift=-.5em]inputtext.south);

        % Draw behind the text.
        \begin{scope}[on background layer]
            \draw[thick, fill=gray, fill opacity=.1]
                (0,-1) rectangle (4,0 |- inputbottom);
        \end{scope}

        \draw[ultra thick,-{Stealth}] (2,-1) -- (2,0);
    }
}

\newcommand{\sdrmphase}[2]{
    \setlength{\mywidth}{4cm}
    \addtolength{\mywidth}{-1.5em}
    \draw[thick, fill=white] (0,0) rectangle (4,\phaseboxheight);
    \draw[] (2,\phaseboxheight-1cm) rectangle (2,\phaseboxheight-1cm)
    node[midway, text width=\mywidth, text centered] {%
        \textbf{%
            \ifthenelse{\equal{#1}{5}}{Evaluation}{}%
            \ifthenelse{\equal{#1}{6}}{Communication}{}
        }
        };
    \draw (2,\phaseboxheight-2cm) rectangle (2,\phaseboxheight-2cm)
    node[below,text width=\mywidth, text centered] {#2};
}


\newcommand{\DSR}[1]{%
    \begingroup%
    \setlength{\phaseboxheight}{3cm}%
    \newcommand{\ProblemIdentification}[2][]{\dsrmmeasurephase{.5em}{##2}}%
    \newcommand{\ObjectivesOfTheSolution}[2][]{\dsrmmeasurephase{.5em}{##2}}%
    \newcommand{\DesignAndDevelopment}[2][]{\dsrmmeasurephase{.5em}{##2}}%
    \newcommand{\Demonstration}[2][]{\dsrmmeasurephase{.5em}{##2}}%
    \newcommand{\Evaluation}[1]{\dsrmmeasurephase{1.5em}{##1}}%
    \newcommand{\Communication}[1]{\dsrmmeasurephase{1.5em}{##1}}%
    \ignorespaces#1%
    \renewcommand{\ProblemIdentification}[2][]{%
        \begin{scope}[%
            shift = {(0, 0)}%
            ]%
            \sdrmphaseinputt[##1]{1}{##2};%
        \end{scope}%
    }%
    \renewcommand{\ObjectivesOfTheSolution}[2][]{%
        \begin{scope}[%
            shift = {(4.5, 0)}%
            ]%
            \sdrmphaseinputt[##1]{2}{##2};%
        \end{scope}%
    }%
    \renewcommand{\DesignAndDevelopment}[2][]{%
        \begin{scope}[%
            shift = {(9, 0)}%
            ]%
            \sdrmphaseinputt[##1]{3}{##2};%
        \end{scope}%
    }%
    \renewcommand{\Demonstration}[2][]{%
        \begin{scope}[%
            shift = {(13.5, 0)}%
            ]%
            \sdrmphaseinputt[##1]{4}{##2};%
        \end{scope}%
    }%
    \renewcommand{\Evaluation}[1]{%
        \begin{scope}[%
            shift = {(18, 0)}%
            ]%
            \sdrmphase{5}{##1};%
        \end{scope}%
    }%
    \renewcommand{\Communication}[1]{%
        \begin{scope}[%
            shift = {(22.5, 0)}%
            ]%
            \sdrmphase{6}{##1};%
        \end{scope}%
    }%
%
    \begin{tikzpicture}[font=\large]%\sffamily]%, every node/.style={scale=1.2}]
        \begin{scope}%
            % horizontal line through phase boxes
            \draw[ultra thick,-{Stealth}] (4,\phaseboxheight-1cm) -- (22.5,\phaseboxheight-1cm);%
            \draw[ultra thick] (6.5,\phaseboxheight+1cm) -- (24.5,\phaseboxheight+1cm);%
            \draw[ultra thick,-{Stealth}] (6.5,\phaseboxheight+1cm) -- (6.5,\phaseboxheight);%
            \draw[ultra thick,-{Stealth}] (11,\phaseboxheight+1cm) -- (11,\phaseboxheight);%
            \draw[ultra thick] (20,\phaseboxheight) -- (20,\phaseboxheight+1cm);%
            \draw[ultra thick] (24.5,\phaseboxheight) -- (24.5,\phaseboxheight+1cm);%
        \end{scope}%
        #1%
    \end{tikzpicture}%
    \endgroup%
}%
